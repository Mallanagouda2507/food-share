rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /donations/{userId}/{allPaths=**} {
      // Anyone can view food donation images
      allow read: if true;
      
      // Only authenticated users can upload images to their folder
      // Images must be < 5MB and valid image MIME type
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
